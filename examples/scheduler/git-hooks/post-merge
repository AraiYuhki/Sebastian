#!/bin/sh
# =============================================================================
# git post-merge フック例 — pull（マージ）のたびに sebastian-ci を実行する
# =============================================================================
# 配置:  .git/hooks/post-merge に置いて chmod +x する
#
# git pull で新しいコミットを取り込んだ直後に自動でパイプラインが走ります。
# 「リモートの変更を手元に取り込んだら、まずCIで確認する」運用に便利です。
# 同じコミットなら自動でスキップされるため、pull のたびに走っても低コストです。
# =============================================================================
exec sebastian-ci . --yes
