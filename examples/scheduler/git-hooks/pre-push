#!/bin/sh
# =============================================================================
# git pre-push フック例 — push する前にテストを通す
# =============================================================================
# 配置:  .git/hooks/pre-push に置いて chmod +x する
#
# push の直前に test ジョブ（とその依存）だけを実行し、失敗したら push を中止します。
# --job 指定の実行は履歴に記録されないため、後の全体実行が誤ってスキップされる
# こともありません。
# =============================================================================
exec sebastian-ci . --job test
